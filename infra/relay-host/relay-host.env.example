# The self-hosted QR relay's settings (P9-01, ADR-0024). Copy to /etc/rp-relay/relay-host.env
# (owner root, mode 600). setup-ubuntu.sh fills the passwords and secrets in for you. Never commit
# the filled-in file.

# The functions' login (relay_edge) and the jobs' login (relay_janitor), on this server only.
RELAY_DB_URL=postgresql://relay_edge:CHANGE_ME@127.0.0.1:5432/rp_relay
RELAY_JOBS_DB_URL=postgresql://relay_janitor:CHANGE_ME@127.0.0.1:5432/rp_relay

# This site's public address, and the origins allowed to call the relay from a browser.
RELAY_PUBLIC_URL=https://menu.example.in
RELAY_ALLOWED_ORIGINS=https://menu.example.in

# The restaurants' open line: a secret for their tokens (at least 32 characters) and a public key
# their socket presents. Generate each with: openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
RELAY_JWT_SECRET=CHANGE_ME
RELAY_REALTIME_API_KEY=CHANGE_ME

# Menu photos, served by Caddy straight from here.
RELAY_PHOTOS_DIR=/var/lib/rp-relay/photos

RELAY_HOST=127.0.0.1
RELAY_PORT=8787
