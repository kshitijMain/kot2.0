.expo/
android/app/build/
# Generated by `expo prebuild` (continuous native generation); never edited by hand.
apps/waiter-app/android/
apps/table-tablet/android/
# Next.js
.next/
.next-pilot/
out/
# Storybook workbench build (packages/ui-web)
storybook-static/
# The Windows installer's staging folder and output (apps/desktop, P0-16d)
apps/desktop/staging/
apps/desktop/release/
# Playwright output (apps/console e2e)
test-results/
playwright-report/
# ZAP's plans, scripts and reports from a DAST run (infra/dast, P8-03c1)
infra/dast/reports/
# ESP-IDF
firmware/**/build/
firmware/**/sdkconfig.old
# Local database data during development
.pgdata/
# Secrets must never be committed (SEC-002)
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
# The public certificate that EAS Update signatures are checked against (SEC-014).
!apps/*/certs/update-signing-certificate.pem
# Generated Prisma clients (regenerated by `pnpm build` / `pnpm --filter <app> generate`)
apps/server/src/generated/
apps/control-plane/src/generated/
# Local server data directory in development
.data/

# Local copies kept beside the repository (the BRD is tracked in docs/brd/)
/latest_context.md
/Restaurant_Platform_BRD_v1.0.pdf

# Vitest report output
.vitest/

# The QR pilot on one Mac (scripts/pilot/mannat-local.sh): databases, secrets, logs
/.pilot/

# Local UI reference clones (index + scripts at design-ref/ are tracked; see design-ref/README.md)
/design-ref/tier-*/

# Pilot print-outs: the QR images and the scan sheet carry live table links (anyone with one can
# order at that table). Print them from Manage -> QR codes or .pilot/mannat-tents.pdf instead.
/MANNAT-QR-SCAN.txt
/mannat-qr-*.png

# Android build output (Gradle), e.g. from building the waiter APK on a Mac; always regenerated
**/android/build/
**/android/.gradle/
**/android/.cxx/
*.apk
*.aab

# Cursor's local settings for this machine
/.cursor/
